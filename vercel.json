    { "source": "/kochi", "destination": "/interior-designers-in-kochi/", "permanent": true },
    { "source": "/kochi/", "destination": "/interior-designers-in-kochi/", "permanent": true },
    { "source": "/kerala", "destination": "/interior-designers-in-kerala/", "permanent": true },
