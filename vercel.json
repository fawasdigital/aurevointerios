    { "source": "/category/insights", "destination": "/blog/", "permanent": true },
    { "source": "/category/insights/", "destination": "/blog/", "permanent": true },
    { "source": "/portfolio/saleel", "destination": "/portfolio/jurisvox/", "permanent": true },
