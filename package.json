{
  "name": "aurevo-static-mirror",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js static site generator — recursive crawl, asset mirror, clean URLs",
  "scripts": {
    "static:generate": "node scripts/static-generator/mirror.js --url https://themes.pixelwars.org/interique/demo-01/home-02/ --output static-site --entry home-02 --delay 600 --scope https://themes.pixelwars.org/interique/demo-01/ --max-pages 80 --root-relative",
    "build:static": "npm run static:generate && npm run download:export-assets && npm run fix:static-ui",
    "fix:static-ui": "node scripts/static-generator/fix-static-ui.js static-site /",
    "deploy:calicut": "node scripts/deploy-calicut.js",
    "deploy:locations": "node scripts/deploy-location-pages.js",
    "hero:calicut": "node scripts/inject-calicut-hero.js calicut",
    "hero:locations": "node scripts/deploy-location-pages.js",
    "mirror": "node scripts/static-generator/mirror.js",
    "mirror:full": "node scripts/static-generator/mirror.js --url https://themes.pixelwars.org/interique/demo-01/home-02/ --output site-export --entry home-02 --delay 600 --scope https://themes.pixelwars.org/interique/demo-01/ --max-pages 80 --root-relative",
    "fix:export-paths": "node scripts/static-generator/fix-export-paths.js",
    "fix:export-images": "node scripts/static-generator/fix-export-images.js static-site /",
    "download:export-assets": "node scripts/static-generator/download-missing-assets.js static-site /"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "fs-extra": "^11.2.0"
  }
}
